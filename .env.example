# ── AWS / Region ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ── DynamoDB Tables ─────────────────────────────────────────────────────
FAMILIES_TABLE=companion-families
MEMBERS_TABLE=companion-members
MESSAGES_TABLE=companion-messages
REMINDERS_TABLE=companion-reminders
SCHEDULER_GROUP_NAME=companion-reminders

# ── Secrets Manager ─────────────────────────────────────────────────────
APP_SECRET_ID=companion/app

# ── Cognito Auth ────────────────────────────────────────────────────────
# Set both to enable Cognito JWT verification (RS256 via JWKS).
# When enabled, POST /api/login/ is disabled — clients must use the
# Cognito Hosted UI or an SDK (Amplify / amazon-cognito-identity-js).
# GET /api/auth/cognito/config/ returns the client-side SDK config.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── Core pipeline LLM ───────────────────────────────────────────────────
# Set at least one provider key. Auto-selects: Sarvam > Gemini > OpenAI.
# (Legacy *_FOOD_ROUTER_* names from before the core/ rewrite are still
# honored as fallbacks — see core/llm/config.py.)

# Sarvam AI — India-hosted, OpenAI-compatible (primary; data-sovereignty).
# sarvam-m (24B) is deprecated on the managed API; use sarvam-30b or sarvam-105b.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-30b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Force a specific provider: sarvam | gemini | openai
# LLM_PROVIDER=

# ── MCP Providers ───────────────────────────────────────────────────────
# Zomato (default)
# MCP_REMOTE_CONFIG_DIR=.mcp-auth
# ZOMATO_MCP_URL=https://mcp-server.zomato.com/mcp

# Swiggy Food
# SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food

# Swiggy Instamart
# SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im

# Zepto
# ZEPTO_MCP_URL=https://mcp.zepto.co.in/mcp

# Kite (Zerodha) — real-money trading MCP
# KITE_MCP_URL=https://mcp.kite.trade/mcp

EXECUTE_ZOMATO_BY_DEFAULT=false
EXECUTE_TOOLS_BY_DEFAULT=false

# ── Twilio Voice Calls ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=       # e.g., +1xxxxxxxxxx (your Twilio phone number)
TWILIO_VOICE_BRIDGE_URL=  # e.g., https://voice.jatayulabs.com (Gemini Live bridge)

# ── Legacy Admin (only used when Cognito is not configured) ─────────────
# Required for local login at http://127.0.0.1:5173 when Cognito vars are empty.
# See docs/LOCAL_SETUP.md and CREDENTIALS.local.example.txt
LEGACY_ADMIN_USERNAME=
LEGACY_ADMIN_PASSWORD=
# JWT_SECRET=

# ── Google Maps (required for Zepto location picker geocoding) ───────────
GOOGLE_MAPS_API_KEY=      # Google Maps Geocoding API key
