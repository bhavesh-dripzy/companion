AWS_REGION=ap-south-1
FAMILIES_TABLE=companion-families
MEMBERS_TABLE=companion-members
MESSAGES_TABLE=companion-messages
REMINDERS_TABLE=companion-reminders
SCHEDULER_GROUP_NAME=companion-reminders
APP_SECRET_ID=companion/app

# Food router LLM — set at least one of:
GEMINI_API_KEY=
GEMINI_FOOD_ROUTER_MODEL=gemini-2.5-flash-lite

OPENAI_API_KEY=
OPENAI_FOOD_ROUTER_MODEL=gpt-4o-mini

# Force provider: unset (auto: Gemini if key exists, else OpenAI), gemini, or openai
# FOOD_ROUTER_PROVIDER=

# Zomato MCP (mcp-remote): OAuth tokens live in MCP_REMOTE_CONFIG_DIR (see mcp-remote).
# Local default is <project>/.mcp-auth. Serverless production should move this
# to a managed token strategy before enabling live Zomato execution by default.
# MCP_REMOTE_CONFIG_DIR=.mcp-auth
# ZOMATO_MCP_URL=https://mcp-server.zomato.com/mcp
EXECUTE_ZOMATO_BY_DEFAULT=false
